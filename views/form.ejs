<% if (errors && errors.length > 0) { %>
  <ul class="error-list">
    <% errors.forEach(err => { %>
      <li><%= err.msg %></li>
    <% }) %>
  </ul>
<% } %>
<h2>New message</h2>
<form method="POST" action="/new" >
    <input name='author' type='text' id='author' placeholder='Author' required>
    <input name='messageText' type='text' id='messageText' placeholder='Message' required>
    <button id='messageText' type='submit'>Submit</button>
</form>